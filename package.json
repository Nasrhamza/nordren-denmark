{
  "name": "nordren",
  "version": "1.0.0",
  "private": true,
  "description": "NordRen cleaning bookings",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
