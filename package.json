    "check:production": "node --env-file-if-exists=.env scripts/preflight.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
